---
import { sampleArtworks } from '../data/sampleArtworks';

const collections = [
  { id: 'all', label: 'All Works' },
  { id: 'new-works', label: 'New Works 2026' },
  { id: 'landscapes', label: 'Landscapes & Botanicals' },
  { id: 'abstracts', label: 'Abstract Studies' },
  { id: 'portraits', label: 'Portraiture' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Lindsay — Neobrutalist Minimalist Prototype</title>
    <meta name="description" content="Minimal neobrutalist portfolio prototype for Lindsay visual art: pure Bento gallery layout with tactile neobrutalist styling." />

    <!-- Google Fonts: Space Grotesk (Punchy Neobrutalist Sans) & Space Mono (Technical Monospace) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="neobrutal-body">
    
    <!-- Top Prototype Sticky Banner -->
    <div class="prototype-top-bar">
      <div class="top-bar-inner">
        <div class="top-bar-left">
          <span class="proto-tag">PROTOTYPE</span>
          <span class="proto-desc">Minimal Neobrutalism • Real Site Layout (Non-Redundant Bento Gallery)</span>
        </div>
        <div class="top-bar-right">
          <span class="proto-fonts">Space Grotesk + Space Mono</span>
          <a href="/" class="proto-return-link">← Return to Real Site</a>
        </div>
      </div>
    </div>

    <!-- Minimal Neobrutalist Masthead Bar (Real Site Nav Layout) -->
    <header class="neo-header-wrapper">
      <div class="neo-header">
        <a href="/prototype" class="neo-brand">
          <span class="brand-badge">L</span>
          <span class="brand-name">LINDSAY</span>
        </a>

        <!-- Real site 3-link navigation -->
        <nav class="neo-nav">
          <a href="/prototype" class="nav-item active">PORTFOLIO</a>
          <a href="/about" class="nav-item">ABOUT</a>
          <a href="/contact" class="nav-item">CONTACT</a>
        </nav>

        <div class="neo-header-cta">
          <a href="/contact" class="neo-btn neo-btn-pink sm">
            INQUIRE ↗
          </a>
        </div>
      </div>
    </header>

    <main class="neo-main">
      <!-- Clean Minimal Header (Matches Real Site Tone & Focus) -->
      <section class="gallery-masthead-section" aria-label="Gallery Introduction">
        <div class="masthead-badge-row">
          <span class="meta-sticker">ORIGINAL PAINTINGS & STUDIES</span>
          <span class="status-indicator-pill">
            <span class="status-dot"></span>
            AVAILABLE FOR COMMISSIONS
          </span>
        </div>
        <h1 class="gallery-main-title">Selected Works</h1>
        <p class="gallery-main-subtitle">
          Original oil paintings, botanical studies, and textural mineral compositions on hand-stretched Belgian linen — 2024–2026.
        </p>
      </section>

      <!-- ========================================================= -->
      <!-- PURE BENTO ARTWORK GALLERY (Non-Redundant Real Layout)   -->
      <!-- ========================================================= -->
      <section class="neo-gallery-section" aria-label="Artwork Gallery Showcase">
        
        <!-- Collection Filter Toolbar -->
        <div class="neo-filters-bar">
          <div class="neo-filters" role="tablist" aria-label="Artwork Collections">
            {collections.map((col, index) => (
              <button
                type="button"
                role="tab"
                class={`neo-filter-pill ${index === 0 ? 'active' : ''}`}
                data-filter={col.id}
                aria-selected={index === 0 ? 'true' : 'false'}
              >
                {col.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Pure Bento Artwork Grid (Zero Redundant Hero Cards) -->
        <div class="neo-artwork-grid" id="artworkGrid">
          {sampleArtworks.map((art) => (
            <article 
              class={`neo-artwork-card neo-${art.bentoSpan}`} 
              data-collection={art.collection}
            >
              <div class="art-media-wrap">
                <img src={art.imageUrl} alt={art.alt} class="art-img" loading="lazy" />
                <span class="art-year-badge">{art.year}</span>
              </div>

              <div class="art-content">
                <div class="art-tag-row">
                  <span class="art-collection-chip">{art.collection.replace('-', ' ')}</span>
                  <span class="art-medium-chip">{art.medium}</span>
                </div>

                <h2 class="art-title">{art.title}</h2>
                
                {art.description && (
                  <p class="art-description">{art.description}</p>
                )}

                <div class="art-footer-meta">
                  <span class="art-dims">{art.dimensions}</span>
                  <a href="/contact" class="art-inquire-btn">Inquire ↗</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Minimal Neobrutalist Footer Card -->
      <footer class="neo-footer-card">
        <h2 class="footer-cta-title">Studio Inquiries & Commissions</h2>
        <p class="footer-cta-sub">
          Works are available directly through the studio or represented galleries. Studio visits by appointment in Brooklyn & London.
        </p>
        <div class="footer-btn-row">
          <a href="/contact" class="neo-btn neo-btn-pink">CONTACT STUDIO ✦</a>
          <a href="/about" class="neo-btn neo-btn-white">ARTIST STATEMENT & BIO</a>
        </div>
        <div class="footer-meta-line">
          <span>© {new Date().getFullYear()} Lindsay. All rights reserved.</span>
          <span class="sep">•</span>
          <span>Neobrutalist Minimalist Prototype</span>
        </div>
      </footer>
    </main>

    <!-- Client-side filter script preserving CSS Grid spans via class toggle -->
    <script>
      const filterPills = document.querySelectorAll<HTMLButtonElement>('.neo-filter-pill');
      const cards = document.querySelectorAll<HTMLElement>('.neo-artwork-card');

      filterPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          filterPills.forEach((p) => {
            p.classList.remove('active');
            p.setAttribute('aria-selected', 'false');
          });
          pill.classList.add('active');
          pill.setAttribute('aria-selected', 'true');

          const filter = pill.dataset.filter;
          cards.forEach((card) => {
            const matches = !filter || filter === 'all' || card.dataset.collection === filter;
            if (matches) {
              card.classList.remove('is-hidden');
            } else {
              card.classList.add('is-hidden');
            }
          });
        });
      });
    </script>
  </body>
</html>

<style>
  /* ============================================================ */
  /* MINIMAL NEOBRUTALIST TOKENS                                 */
  /* ============================================================ */
  :root {
    --neo-bg: #FAF6EE;           /* Warm paper cream canvas */
    --neo-card-bg: #FFFFFF;      /* Clean card white */
    --neo-black: #121212;        /* Pitch black stroke & ink */
    --neo-pink: #FF6B8B;         /* Coral pink button accent */
    --neo-yellow: #FFD166;       /* Marigold yellow badge accent */
    --neo-green: #06D6A0;        /* Emerald availability indicator */
    --neo-muted: #555555;        /* Secondary technical text */
    
    --neo-stroke: 2.5px solid var(--neo-black);
    --neo-shadow: 5px 5px 0px var(--neo-black);
    --neo-shadow-sm: 3px 3px 0px var(--neo-black);
    --neo-shadow-xs: 2px 2px 0px var(--neo-black);
    --neo-shadow-hover: 7px 7px 0px var(--neo-black);
    
    --neo-radius: 20px;
    --neo-radius-sm: 10px;
    --neo-radius-pill: 9999px;

    --font-neo-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-neo-mono: 'Space Mono', SFMono-Regular, Menlo, monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body.neobrutal-body {
    background-color: var(--neo-bg);
    color: var(--neo-black);
    font-family: var(--font-neo-heading);
    line-height: 1.5;
    min-height: 100vh;
    padding-bottom: 96px;
    -webkit-font-smoothing: antialiased;
  }

  /* Sticky Prototype Announcement */
  .prototype-top-bar {
    background-color: var(--neo-yellow);
    border-bottom: var(--neo-stroke);
    padding: 10px 20px;
    font-family: var(--font-neo-mono);
    font-size: 0.78rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .top-bar-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .top-bar-left, .top-bar-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .proto-tag {
    background: var(--neo-black);
    color: #ffffff;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.08em;
  }

  .proto-desc {
    font-weight: 700;
  }

  .proto-fonts {
    color: #333;
    font-weight: 500;
  }

  .proto-return-link {
    color: var(--neo-black);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.15s ease;
  }

  .proto-return-link:hover {
    background: rgba(0, 0, 0, 0.08);
  }

  /* ============================================================ */
  /* NEOBRUTALIST MASTHEAD (Real Nav Layout: Brand + 3 Links)     */
  /* ============================================================ */
  .neo-header-wrapper {
    max-width: 1240px;
    margin: 28px auto 36px;
    padding: 0 24px;
  }

  .neo-header {
    background: #FFFFFF;
    border: var(--neo-stroke);
    box-shadow: var(--neo-shadow);
    border-radius: var(--neo-radius-pill);
    padding: 12px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .neo-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--neo-black);
  }

  .brand-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--neo-yellow);
    border: var(--neo-stroke);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-family: var(--font-neo-mono);
    font-size: 1rem;
    box-shadow: var(--neo-shadow-xs);
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }

  .neo-nav {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .nav-item {
    text-decoration: none;
    color: var(--neo-black);
    font-family: var(--font-neo-mono);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    position: relative;
    padding: 6px 14px;
    border-radius: var(--neo-radius-pill);
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    background-color: rgba(0, 0, 0, 0.06);
  }

  .nav-item.active {
    background-color: var(--neo-black);
    color: #FFFFFF;
  }

  /* Tactile Button */
  .neo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    border-radius: var(--neo-radius-pill);
    border: var(--neo-stroke);
    box-shadow: var(--neo-shadow-sm);
    font-family: var(--font-neo-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    user-select: none;
  }

  .neo-btn:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .neo-btn:active {
    transform: translate(2px, 2px);
    box-shadow: var(--neo-shadow-xs);
  }

  .neo-btn.sm {
    padding: 8px 18px;
    font-size: 0.78rem;
    box-shadow: var(--neo-shadow-xs);
  }

  .neo-btn-pink {
    background-color: var(--neo-pink);
    color: var(--neo-black);
  }

  .neo-btn-white {
    background-color: #FFFFFF;
    color: var(--neo-black);
  }

  /* Main Container */
  .neo-main {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ============================================================ */
  /* GALLERY MASTHEAD HEADER                                      */
  /* ============================================================ */
  .gallery-masthead-section {
    margin-bottom: 36px;
  }

  .masthead-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .meta-sticker {
    font-family: var(--font-neo-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: var(--neo-black);
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .status-indicator-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1.5px solid var(--neo-black);
    padding: 4px 12px;
    border-radius: var(--neo-radius-pill);
    font-family: var(--font-neo-mono);
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: var(--neo-shadow-xs);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--neo-green);
    border: 1px solid var(--neo-black);
  }

  .gallery-main-title {
    font-size: clamp(2.5rem, 4.5vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 12px;
  }

  .gallery-main-subtitle {
    font-family: var(--font-neo-mono);
    font-size: 0.95rem;
    color: var(--neo-muted);
    max-width: 700px;
    line-height: 1.6;
  }

  /* ============================================================ */
  /* COLLECTION FILTER TOOLBAR                                    */
  /* ============================================================ */
  .neo-filters-bar {
    margin-bottom: 32px;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .neo-filters {
    display: flex;
    gap: 10px;
    white-space: nowrap;
  }

  .neo-filter-pill {
    background: #FFFFFF;
    border: var(--neo-stroke);
    box-shadow: var(--neo-shadow-xs);
    padding: 9px 18px;
    border-radius: var(--neo-radius-pill);
    font-family: var(--font-neo-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--neo-black);
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .neo-filter-pill:hover {
    background-color: #F8F5EE;
    transform: translate(-1px, -1px);
    box-shadow: var(--neo-shadow-sm);
  }

  .neo-filter-pill.active {
    background-color: var(--neo-black);
    color: #FFFFFF;
    box-shadow: 3px 3px 0px var(--neo-yellow);
  }

  /* ============================================================ */
  /* PURE BENTO ARTWORK GRID                                      */
  /* ============================================================ */
  .neo-artwork-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 28px;
    margin-bottom: 64px;
  }

  /* CSS class-based filter utility to prevent CSS Grid collapse */
  .neo-artwork-card.is-hidden {
    display: none !important;
  }

  .neo-artwork-card {
    background: #FFFFFF;
    border: var(--neo-stroke);
    box-shadow: var(--neo-shadow);
    border-radius: var(--neo-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .neo-artwork-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--neo-shadow-hover);
  }

  /* Bento Spans */
  .neo-hero {
    grid-column: span 7;
  }

  .neo-tall {
    grid-column: span 5;
  }

  .neo-square {
    grid-column: span 4;
  }

  .neo-wide {
    grid-column: span 8;
  }

  .art-media-wrap {
    position: relative;
    width: 100%;
    background-color: #EFECE5;
    border-bottom: var(--neo-stroke);
    overflow: hidden;
  }

  .neo-hero .art-media-wrap {
    aspect-ratio: 16/10;
  }

  .neo-tall .art-media-wrap {
    aspect-ratio: 4/5;
  }

  .neo-square .art-media-wrap {
    aspect-ratio: 1/1;
  }

  .neo-wide .art-media-wrap {
    aspect-ratio: 16/9;
  }

  .art-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .neo-artwork-card:hover .art-img {
    transform: scale(1.025);
  }

  .art-year-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--neo-yellow);
    border: 2px solid var(--neo-black);
    box-shadow: var(--neo-shadow-xs);
    padding: 3px 10px;
    border-radius: var(--neo-radius-pill);
    font-family: var(--font-neo-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .art-content {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .art-tag-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .art-collection-chip {
    font-family: var(--font-neo-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    background: #F4EFE6;
    border: 1.5px solid var(--neo-black);
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .art-medium-chip {
    font-family: var(--font-neo-mono);
    font-size: 0.72rem;
    color: var(--neo-muted);
  }

  .art-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .art-description {
    font-size: 0.88rem;
    color: #444444;
    margin-bottom: 18px;
    line-height: 1.55;
  }

  .art-footer-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1.5px dashed #D0CCC3;
    padding-top: 14px;
    margin-top: auto;
  }

  .art-dims {
    font-family: var(--font-neo-mono);
    font-size: 0.75rem;
    color: var(--neo-muted);
    font-weight: 600;
  }

  .art-inquire-btn {
    font-family: var(--font-neo-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--neo-black);
    text-decoration: none;
    border-bottom: 2px solid var(--neo-black);
    padding-bottom: 1px;
    transition: all 0.15s ease;
  }

  .art-inquire-btn:hover {
    color: var(--neo-pink);
    border-color: var(--neo-pink);
  }

  /* ============================================================ */
  /* MINIMAL NEOBRUTALIST FOOTER CARD                             */
  /* ============================================================ */
  .neo-footer-card {
    background: #FFFFFF;
    border: var(--neo-stroke);
    box-shadow: var(--neo-shadow);
    border-radius: var(--neo-radius);
    padding: 48px 32px;
    text-align: center;
    margin-top: 24px;
  }

  .footer-cta-title {
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .footer-cta-sub {
    font-size: 0.95rem;
    color: var(--neo-muted);
    margin-bottom: 24px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .footer-btn-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .footer-meta-line {
    font-family: var(--font-neo-mono);
    font-size: 0.75rem;
    color: #888888;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .footer-meta-line .sep {
    color: #CCCCCC;
  }

  /* ============================================================ */
  /* RESPONSIVE LAYOUT BREAKPOINTS                                */
  /* ============================================================ */
  @media (max-width: 992px) {
    .neo-hero, .neo-wide {
      grid-column: span 12;
    }
    .neo-tall, .neo-square {
      grid-column: span 6;
    }
    .neo-header {
      padding: 10px 20px;
    }
  }

  @media (max-width: 680px) {
    .neo-tall, .neo-square {
      grid-column: span 12;
    }
    .neo-header {
      flex-direction: column;
      border-radius: var(--neo-radius);
      padding: 16px;
      gap: 14px;
    }
    .neo-nav {
      width: 100%;
      justify-content: space-around;
      gap: 8px;
    }
    .neo-header-cta {
      width: 100%;
    }
    .neo-header-cta .neo-btn {
      width: 100%;
    }
    .gallery-main-title {
      font-size: 2.2rem;
    }
    .top-bar-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
