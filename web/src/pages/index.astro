---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { sampleArtworks } from '../data/sampleArtworks';

const collections = [
  { id: 'all', label: 'All Works' },
  { id: 'new-works', label: 'New Works' },
  { id: 'landscapes', label: 'Landscapes & Botanicals' },
  { id: 'abstracts', label: 'Abstract Studies' },
  { id: 'portraits', label: 'Portraiture' },
];
---

<Layout title="Lindsay — Selected Works & Contemporary Art">
  <!-- Collection Filter Bar -->
  <section class="gallery-toolbar" aria-label="Artwork Collections">
    <div class="filter-pill-list">
      {collections.map((col, index) => (
        <button
          type="button"
          class={`filter-pill ${index === 0 ? 'active' : ''}`}
          data-filter={col.id}
        >
          {col.label}
        </button>
      ))}
    </div>
  </section>

  <!-- Bento Box Artwork Showcase -->
  <section class="gallery-section" aria-label="Artwork Gallery">
    <div class="bento-grid" id="artworkGrid">
      {sampleArtworks.map((art) => (
        <div data-collection={art.collection} class="gallery-cell">
          <ArtworkCard artwork={art} />
        </div>
      ))}
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="editorial-section">
    <div class="editorial-grid">
      <div class="editorial-image-wrapper">
        <img
          src="/artworks/lindsay-portrait.jpg"
          alt="Artist portrait of Lindsay working in natural light studio"
          class="editorial-portrait"
          loading="eager"
        />
      </div>
      <div class="editorial-copy">
        <span class="section-label">Artist Statement</span>
        <h2 class="editorial-heading">Exploring organic form, pigment, and quiet contemplation.</h2>
        <div class="editorial-body">
          <p>
            Lindsay is a contemporary visual artist working primarily with oil, dry pigments, and mixed media.
            Her practice balances bold architectural structure with the delicate fragility of natural landscapes,
            inviting viewers into quiet spaces of observation.
          </p>
          <p>
            Each piece develops slowly through layers of natural glazes, impasto textures, and mineral dust,
            capturing changing light across coastal hills and botanical undergrowth.
          </p>
        </div>
        <div class="exhibitions-preview">
          <h3 class="exhibitions-title">Selected Exhibitions</h3>
          <ul class="exhibitions-list">
            <li><span class="ex-year">2026</span> <span class="ex-name">Luminescence</span> — Gallery Meridian, New York</li>
            <li><span class="ex-year">2025</span> <span class="ex-name">Mineral & Void</span> — Studio Oberlin, London</li>
            <li><span class="ex-year">2024</span> <span class="ex-name">New Botanical Form</span> — Pacific Contemporary, San Francisco</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="contact-section">
    <div class="contact-card">
      <span class="section-label">Studio Inquiries</span>
      <h2 class="contact-heading">Get in touch regarding exhibitions and commissions.</h2>
      <p class="contact-lead">
        For studio visits, gallery representations, or editorial projects, please contact the studio directly.
      </p>
      <div class="contact-links">
        <a href="mailto:studio@lindsay-art.com" class="contact-button">Email Studio</a>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="contact-link">
          Instagram @lindsay.art ↗
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Lightweight, zero-dependency client-side collection filtering
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cells = document.querySelectorAll<HTMLElement>('.gallery-cell');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');

      const filter = pill.dataset.filter;
      cells.forEach((cell) => {
        if (!filter || filter === 'all' || cell.dataset.collection === filter) {
          cell.style.display = 'block';
        } else {
          cell.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* Gallery Toolbar */
  .gallery-toolbar {
    margin-bottom: var(--space-xl);
    overflow-x: auto;
    padding-bottom: var(--space-xs);
  }

  .filter-pill-list {
    display: flex;
    gap: var(--space-xs);
    white-space: nowrap;
  }

  .filter-pill {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-ink-muted);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: var(--space-xs) var(--space-md);
    border-radius: 9999px;
    cursor: pointer;
    transition: all var(--transition-smooth);
  }

  .filter-pill:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .filter-pill.active {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: #ffffff;
  }

  /* Gallery Section */
  .gallery-section {
    margin-bottom: var(--space-3xl);
  }

  .gallery-cell {
    display: contents;
  }

  /* Editorial / About Section */
  .editorial-section {
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 900px) {
    .editorial-grid {
      grid-template-columns: 4fr 6fr;
      gap: var(--space-3xl);
    }
  }

  .editorial-image-wrapper {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 4/5;
    box-shadow: var(--shadow-subtle);
  }

  .editorial-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .editorial-heading {
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.25;
    margin-bottom: var(--space-lg);
    color: var(--color-ink);
  }

  .editorial-body p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-md);
  }

  .exhibitions-preview {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .exhibitions-title {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }

  .exhibitions-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .exhibitions-list li {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  .ex-year {
    font-weight: 600;
    color: var(--color-ink);
    margin-right: var(--space-xs);
  }

  /* Contact Section */
  .contact-section {
    padding: var(--space-3xl) 0 var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .contact-card {
    max-width: 720px;
  }

  .contact-heading {
    font-size: 2rem;
    margin-bottom: var(--space-md);
    color: var(--color-ink);
  }

  .contact-lead {
    font-size: 1.05rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .contact-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .contact-button {
    background-color: var(--color-ink);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-sm) var(--space-xl);
    border-radius: 9999px;
    transition: background-color var(--transition-smooth), transform var(--transition-smooth);
  }

  .contact-button:hover {
    background-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .contact-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    letter-spacing: 0.04em;
  }

  .contact-link:hover {
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .editorial-heading {
      font-size: 1.75rem;
    }
    .contact-heading {
      font-size: 1.5rem;
    }
  }
</style>
