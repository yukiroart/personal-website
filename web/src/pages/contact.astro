---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Lindsay — Studio Inquiries, Commissions & Gallery Representation"
  description="Contact artist Lindsay for original artwork acquisitions, gallery exhibitions, studio visits, and commissions."
>
  <div class="contact-container">
    <header class="contact-header">
      <span class="section-label">Studio & Curatorial Inquiries</span>
      <h1 class="page-title">Contact Lindsay</h1>
    </header>

    <div class="contact-grid">
      <!-- Direct Contact Details -->
      <aside class="details-column">
        <section class="detail-block">
          <h2 class="detail-label">Direct Studio Email</h2>
          <a href="mailto:studio@lindsay-art.com" class="email-link">studio@lindsay-art.com</a>
          <p class="detail-desc">For general correspondence, acquisitions, and press.</p>
        </section>

        <section class="detail-block">
          <h2 class="detail-label">Gallery Representation</h2>
          <div class="rep-item">
            <p class="rep-name">Gallery Meridian</p>
            <p class="rep-city">New York, NY</p>
            <a href="mailto:curator@gallerymeridian.com" class="rep-link">curator@gallerymeridian.com</a>
          </div>
          <div class="rep-item">
            <p class="rep-name">Studio Oberlin</p>
            <p class="rep-city">London, UK</p>
            <a href="mailto:info@studiooberlin.co.uk" class="rep-link">info@studiooberlin.co.uk</a>
          </div>
        </section>

        <section class="detail-block">
          <h2 class="detail-label">Studio Visits</h2>
          <p class="detail-desc">
            Private studio visits in coastal California are welcomed by appointment for collectors and curators.
          </p>
        </section>

        <section class="detail-block">
          <h2 class="detail-label">Studio Updates</h2>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            Instagram @lindsay.art ↗
          </a>
        </section>
      </aside>

      <!-- Inquiry Message Form -->
      <section class="form-column">
        <div class="form-card">
          <h2 class="form-title">Send a Studio Message</h2>
          <p class="form-lead">
            Please fill out the form below. Inquiries are reviewed and answered within 2–3 business days.
          </p>

          <form class="inquiry-form" action="mailto:studio@lindsay-art.com" method="post" enctype="text/plain">
            <div class="form-group">
              <label for="name" class="form-label">Your Name</label>
              <input type="text" id="name" name="name" required class="form-input" placeholder="e.g. Eleanor Vance" />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" id="email" name="email" required class="form-input" placeholder="eleanor@example.com" />
            </div>

            <div class="form-group">
              <label for="inquiryType" class="form-label">Inquiry Type</label>
              <select id="inquiryType" name="inquiryType" class="form-select">
                <option value="acquisition">Artwork Acquisition / Availability</option>
                <option value="exhibition">Exhibition / Curatorial Proposal</option>
                <option value="commission">Custom Commission Request</option>
                <option value="press">Press & Publication</option>
                <option value="studio-visit">Private Studio Visit</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="form-textarea"
                placeholder="Share details about the work you are interested in or your project proposal..."
              ></textarea>
            </div>

            <button type="submit" class="submit-button">Send Inquiry</button>
          </form>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .contact-container {
    padding-top: var(--space-md);
  }

  .contact-header {
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-lg);
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .page-title {
    font-size: 3rem;
    color: var(--color-ink);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-3xl);
    }
  }

  /* Details Column */
  .detail-block {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .detail-block:last-child {
    border-bottom: none;
  }

  .detail-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .email-link {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--transition-smooth);
  }

  .email-link:hover {
    text-decoration-color: var(--color-accent);
  }

  .detail-desc {
    font-size: 0.95rem;
    color: var(--color-ink-muted);
    margin-top: var(--space-xs);
    line-height: 1.6;
  }

  .rep-item {
    margin-top: var(--space-md);
  }

  .rep-name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .rep-city {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  .rep-link {
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .social-link {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  /* Form Column */
  .form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-subtle);
  }

  .form-title {
    font-size: 1.75rem;
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }

  .form-lead {
    font-size: 0.95rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .form-label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }

  .form-input,
  .form-select,
  .form-textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    outline: none;
    transition: border-color var(--transition-smooth), background-color var(--transition-smooth);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--color-ink);
    background-color: #ffffff;
  }

  .submit-button {
    margin-top: var(--space-sm);
    background-color: var(--color-ink);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-md) var(--space-xl);
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color var(--transition-smooth), transform var(--transition-smooth);
  }

  .submit-button:hover {
    background-color: var(--color-accent);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 2.25rem;
    }
    .form-card {
      padding: var(--space-lg);
    }
  }
</style>
