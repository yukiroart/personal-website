---
import type { Artwork } from '../data/sampleArtworks';

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const spanClass = `bento-${artwork.bentoSpan}`;
---

<article class={`bento-item ${spanClass} artwork-card`}>
  <div class="image-wrapper">
    <img
      src={artwork.imageUrl}
      alt={artwork.alt}
      loading="lazy"
      class="artwork-image"
    />
    <div class="overlay" aria-hidden="true">
      <div class="overlay-content">
        <h2 class="artwork-title">{artwork.title}</h2>
        <p class="artwork-meta">{artwork.medium}</p>
        <p class="artwork-sub">{artwork.dimensions} · {artwork.year}</p>
      </div>
    </div>
  </div>
</article>

<style>
  .artwork-card {
    cursor: pointer;
    user-select: none;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .artwork-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .artwork-card:hover .artwork-image {
    transform: scale(1.04);
  }

  /* Refined, gallery-grade hover overlay */
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(23, 22, 21, 0.85) 0%,
      rgba(23, 22, 21, 0.4) 40%,
      rgba(23, 22, 21, 0) 100%
    );
    opacity: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-lg);
    transition: opacity 350ms ease-out;
  }

  .artwork-card:hover .overlay,
  .artwork-card:focus-within .overlay {
    opacity: 1;
  }

  .overlay-content {
    color: #ffffff;
    transform: translateY(8px);
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .artwork-card:hover .overlay-content,
  .artwork-card:focus-within .overlay-content {
    transform: translateY(0);
  }

  .artwork-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: var(--space-2xs);
  }

  .artwork-meta {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.85);
  }

  .artwork-sub {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 2px;
  }
</style>
